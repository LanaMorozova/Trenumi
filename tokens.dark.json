        "$type": "color",
        "$value": "{color.dark.700}"
      }
    },
    "count": {
      "bg": {
        "$type": "color",
        "$value": "#ffffff1a"
      },
      "bg-on-selected": {
        "$type": "color",
        "$value": "#0b051524"
      }
    }
  },
  "shadow": {
    "card": {
      "$type": "color",
      "$value": "{color.shadow.none}"
    },
    "floating": {
      "$type": "color",
      "$value": "{color.shadow.black-28}"
    },
    "sheet": {
      "$type": "color",
      "$value": "{color.shadow.black-40}"
    }
  }
}
