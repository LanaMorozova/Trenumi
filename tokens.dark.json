    "warning": {
      "bg": {
        "$type": "color",
        "$value": "{color.dark.900}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.warning.400}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.warning.400}"
      }
    },
    "success": {
      "bg": {
        "$type": "color",
        "$value": "{color.dark.900}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.success.400}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.success.400}"
      }
    },
    "info": {
      "bg": {
        "$type": "color",
        "$value": "{color.dark.900}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.info.400}"
