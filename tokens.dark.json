{
  "$description": "Dark-mode overrides for the semantic layer. Only tokens whose value differs from tokens.json appear here; primitives are shared. Exported from the Figma Semantic Colors collection, Dark mode.",
  "text": {
    "primary": {
      "$type": "color",
      "$value": "{color.neutral.0}"
    },
    "secondary": {
      "$type": "color",
      "$value": "{color.neutral.400}"
    },
    "disabled": {
      "$type": "color",
      "$value": "{color.dark.400}"
    },
    "inverse": {
      "$type": "color",
      "$value": "{color.brand.ink}"
    }
  },
  "bg": {
    "canvas": {
      "$type": "color",
      "$value": "{color.brand.ink}"
    },
    "overlay": {
      "$type": "color",
      "$value": "{color.overlay.dark}"
    }
  },
  "surface": {
    "default": {
      "$type": "color",
      "$value": "{color.dark.900}"
    },
    "elevated": {
      "$type": "color",
      "$value": "{color.dark.800}"
    }
  },
  "border": {
    "focus": {
      "$type": "color",
      "$value": "{color.brand.lime}"
    },
    "interactive": {
      "$type": "color",
      "$value": "{color.dark.500}"
    },
    "subtle": {
      "$type": "color",
      "$value": "{color.dark.700}"
    }
  },
  "action": {
    "primary": {
      "bg": {
        "$type": "color",
        "$value": "{color.brand.lime}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.brand.ink}"
      }
    },
    "secondary": {
      "bg": {
        "$type": "color",
        "$value": "{color.dark.800}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.dark.500}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.neutral.0}"
      }
    },
    "accent": {
      "border": {
        "$type": "color",
        "$value": "{color.alpha.transparent}"
      }
    },
    "destructive": {
      "bg": {
        "$type": "color",
        "$value": "{color.error.400}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.brand.ink}"
      }
    },
    "disabled": {
      "bg": {
        "$type": "color",
        "$value": "{color.dark.700}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.dark.400}"
      }
    }
  },
  "icon": {
    "primary": {
      "$type": "color",
      "$value": "{color.neutral.0}"
    },
    "secondary": {
      "$type": "color",
      "$value": "{color.neutral.400}"
    },
    "disabled": {
      "$type": "color",
      "$value": "{color.dark.400}"
    }
  },
  "input": {
    "bg": {
      "$type": "color",
      "$value": "{color.dark.900}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.dark.500}"
    },
    "border-focus": {
      "$type": "color",
      "$value": "{color.brand.lime}"
